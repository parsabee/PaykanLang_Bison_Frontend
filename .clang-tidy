# PaykanLang clang-tidy configuration.
#
# Bug-focused, blocking gate: only the high-signal families that catch real
# defects are enabled, and findings are treated as errors in CI. Stylistic
# families (readability/modernize/misc namespace & include rules) are
# intentionally left off so the gate stays low-noise and actionable.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  clang-analyzer-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions

WarningsAsErrors: '*'
# PaykanLang's configuration, except for the header filter: the generated
# parser header (<build>/src/Parser.ypp.h) and the installed PaykanLang
# headers are not this repository's to fix.
HeaderFilterRegex: '.*/src/BisonFrontend\.h$'
FormatStyle: file
